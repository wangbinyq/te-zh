---
import "../styles/global.css";
import { book } from "../data/chapters.js";

const { title, subtitle, titleEn, author, authorEn, series } = book;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f7f4ef" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#16151a" media="(prefers-color-scheme: dark)" />
    <title>{title + "：" + subtitle}</title>
    <meta name="description" content={`${author}《${title}：${subtitle}》中译本，${titleEn}`} />
    <slot name="head" />
  </head>
  <body data-base={import.meta.env.BASE_URL}>
    <slot />
  </body>
</html>
